# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Rules source refresh and abuse controls
RULES_AUTO_REFRESH=true
RULES_SCHEDULED_REFRESH=true
RULES_REFRESH_TOKEN=replace-with-a-random-secret
RULES_INDEX_MAX_AGE_MS=86400000
RULES_ASK_RATE_WINDOW_MS=60000
RULES_ASK_RATE_MAX=30
RULES_QUESTION_MAX_CHARS=500

# Optional AI presentation layer. Keep false for the faster, source-built answers.
RULES_ENABLE_LLM_REWRITE=false
ANTHROPIC_API_KEY=
RULES_LLM_MODEL=claude-haiku-4-5
RULES_LLM_TIMEOUT_MS=15000
RULES_LLM_MAX_TOKENS=600

# Rules alerts. Configure either webhook delivery, email delivery, or both.
RULES_ALERT_WEBHOOK_URL=
RULES_ALERT_RESEND_API_KEY=
RULES_ALERT_EMAIL_FROM=
RULES_ALERT_EMAIL_TO=
RULES_ALERT_EMAIL_SUBJECT_PREFIX=Sterling Ranch Rules Assistant alert

# Existing question analytics/log destinations. Blank values disable the matching destination.
RULES_QUESTION_LOG_WEBHOOK_URL=
RULES_QUESTION_NOTION_TOKEN=
RULES_QUESTION_NOTION_DATABASE_ID=

# Openings source monitor and resident tips
OPENINGS_AUTO_MONITOR=true
OPENINGS_MONITOR_INTERVAL_MS=86400000
OPENINGS_MONITOR_START_DELAY_MS=60000
OPENINGS_TIP_WEBHOOK_URL=
OPENINGS_TIP_RESEND_API_KEY=
OPENINGS_TIP_EMAIL_FROM=
OPENINGS_TIP_EMAIL_TO=

# Shared email provider fallback
RESEND_API_KEY=
